{
    "name": "os2web/os2web",
    "type": "drupal-profile",
    "description": "Drupal 8 OS2Web installation profile",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "EUPL-1.2",
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "assets": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
     },
    "require": {
        "os2core/os2core": "dev-drupal10",
        "drupal/ckeditor_iframe": "^2.0 || ^3.0",
        "drupal/menu_item_extras": "^2.11 || ^3.0",
        "drupal/metatag": "^2.0",
        "drupal/textfield_counter": "^2.3",
        "drupal/save_edit": "^1.3",
        "drupal/rules": "3.x-dev@dev",
        "drupal/user_delete_reassign": "1.x-dev@dev",
        "drupal/node_revision_delete": "2.0.x-dev@dev",
        "drupal/facets": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "simplesamlphp/composer-module-installer": true
        }
    }
}
